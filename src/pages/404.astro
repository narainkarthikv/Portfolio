---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Page not found — Narainkarthik Vellingiri" pathname="/404" noindex>
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 p-8 text-center">
    <p class="font-mono text-sm uppercase tracking-[0.2em] text-skin-hue">404</p>
    <h1 class="text-4xl font-bold text-skin-base">Page not found</h1>
    <p class="max-w-md text-skin-muted">The page you’re looking for doesn’t exist or may have moved.</p>
    <div class="flex gap-3">
      <a data-ccursor="lift" class="rounded-md bg-skin-button-accent px-4 py-2 text-skin-inverted" href="/">Back to portfolio</a>
      <a data-ccursor="lift" class="rounded-md bg-skin-button-muted px-4 py-2 text-skin-base" href="/blog">Read the blog</a>
    </div>
  </main>
</Layout>
