---
import CV from '@cv'
const { basics } = CV;

interface Props {
  title: string;
  description?: string;
  image?: string;
  pathname?: string;
  noindex?: boolean;
}

const { name, fullName, alternateName, url, profiles } = basics;

const site = String(Astro.site ?? import.meta.env.SITE ?? url ?? 'https://narainkarthikv.com').replace(/\/$/, '');

const props = Astro.props as Props;
const title = props.title ?? `Portfolio | ${fullName ?? name}`;
const description = props.description ?? 'AI-augmented software engineer with 2 years building high-performance web apps and using Claude and MCP to streamline delivery from design to deployment.';
const imagePath = props.image ?? '/og-image.png';
const imageUrl = `${site}${imagePath.startsWith('/') ? imagePath : `/${imagePath}`}`;
const canonical = `${site}${props.pathname ?? '/'}`;
const robots = props.noindex ? 'noindex,follow' : 'index,follow';
const imageType = imagePath.toLowerCase().endsWith('.webp')
  ? 'image/webp'
  : imagePath.toLowerCase().endsWith('.jpg') || imagePath.toLowerCase().endsWith('.jpeg')
    ? 'image/jpeg'
    : 'image/png';

const twitterProfile = [...(profiles || []), ...(basics.keyboardProfiles || [])].find(
  (p: any) => p.network.toLowerCase().includes('twitter') || p.network.toLowerCase().includes('x')
);
const sameAs = [...(profiles || []), ...(basics.keyboardProfiles || [])]
  .map((profile: any) => profile.url)
  .filter((profileUrl: unknown): profileUrl is string => typeof profileUrl === 'string' && /^https?:\/\//.test(profileUrl));

// JSON-LD structured data
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site}/#person`,
      "name": alternateName?.[0] ?? fullName ?? name,
      "alternateName": [name, fullName, ...(alternateName ?? [])].filter((value): value is string => typeof value === 'string'),
      "url": site,
      "image": imageUrl,
      "jobTitle": basics.label ?? undefined,
      "description": description,
      "knowsAbout": ['React.js', 'Node.js', 'Express.js', 'MongoDB', 'Azure', 'GCP', 'Docker'],
      "address": basics.location ? {
        "@type": "PostalAddress",
        "addressLocality": basics.location.city,
        "addressRegion": basics.location.region,
        "addressCountry": basics.location.countryCode
      } : undefined,
      "sameAs": sameAs
    },
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      "url": String(site),
      "name": `${alternateName?.[0] ?? fullName ?? name} Portfolio`,
      "description": description,
      "inLanguage": "en",
      "publisher": { "@id": `${site}/#person` },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      "url": canonical,
      "name": title,
      "description": description,
      "inLanguage": "en",
      "isPartOf": { "@id": `${site}/#website` },
      "about": { "@id": `${site}/#person` },
    },
  ]
}

const ldJson = JSON.stringify(ld).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0ea5e9" />
<meta name="author" content={fullName ?? name} />
<meta name="robots" content={robots} />
<meta name="color-scheme" content="light dark" />
<meta name="application-name" content={fullName ?? name} />
<meta name="apple-mobile-web-app-title" content={fullName ?? name} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="format-detection" content="telephone=no" />
<link rel="canonical" href={canonical.trim()} />

<!-- Open Graph -->
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={alternateName?.[0] ?? fullName ?? name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical.trim()} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={`${fullName ?? name} | AI Augmented Software Engineer`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content={imageType} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={`${fullName ?? name} profile and portfolio preview`} />
{twitterProfile && (
  <>
    <meta name="twitter:site" content={twitterProfile.username ? `@${twitterProfile.username}` : undefined} />
    <meta name="twitter:creator" content={twitterProfile.username ? `@${twitterProfile.username}` : undefined} />
  </>
)}

<!-- Structured data -->
<script type="application/ld+json" is:inline set:html={ldJson}></script>
