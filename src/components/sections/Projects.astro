---
import Section from "../Section.astro";
import { Icon } from "astro-icon/components";

import { projects } from "@cv";

const MAX_MOBILE_STACK = 3;
const MAX_DESKTOP_STACK = 4;
const DESKTOP_DESCRIPTION_WORD_LIMIT = 22;
const CASE_STUDY_SECTION_KEYS = ["overview", "UX", "DX", "technicalNeeds", "tradeoffs", "highlights"] as const;
const DESKTOP_CASE_TABS = [["overview", "highlights"], ["UX", "DX"], ["technicalNeeds", "tradeoffs"]] as const;
const MOBILE_CASE_TABS = [["overview", "highlights"], ["UX", "DX"], ["technicalNeeds", "tradeoffs"]] as const;
const CASE_STUDY_SECTION_TITLES: Record<(typeof CASE_STUDY_SECTION_KEYS)[number], string> = {
  overview: "Overview",
  UX: "UX",
  DX: "DX",
  technicalNeeds: "Technical Needs",
  tradeoffs: "Trade-offs",
  highlights: "Highlights",
};

function getStackSegments(stack: Record<string, string | undefined> | undefined) {
  const stackEntries = stack ? Object.entries(stack) : [];
  const mobileOverflowCount = Math.max(0, stackEntries.length - MAX_MOBILE_STACK);
  const desktopOverflowCount = Math.max(0, stackEntries.length - MAX_DESKTOP_STACK);
  return { stackEntries, mobileOverflowCount, desktopOverflowCount };
}

function shortDescriptionFrom(description: string) {
  const words = description.split(" ");
  return words.length > DESKTOP_DESCRIPTION_WORD_LIMIT ? `${words.slice(0, DESKTOP_DESCRIPTION_WORD_LIMIT).join(" ")}...` : description;
}

---

<Section className={Astro.props.className}>
  <div class="projects-coverflow print:flex print:flex-col">
    <div class="flex items-center justify-between">
      <h3 data-ccursor="lift" class="relative flex w-max items-center gap-3 pb-4 text-3xl print:gap-1 print:pb-0 print:text-xl sm:hover:text-skin-hue">
        Projects
      </h3>
      <div class="inline-flex items-center gap-2 pb-4">
        <button
          type="button"
          data-projects-prev
          data-ccursor="lift"
          class="inline-flex items-center justify-center size-10 rounded-full bg-skin-button-muted/60 ring-1 ring-white/20 dark:ring-white/10 hover:ring-2 hover:ring-skin-hue/60 transition"
          aria-label="View previous project"
        >
          <Icon name="mdi:arrow-left" class="size-5" />
        </button>
        <button
          type="button"
          data-projects-next
          data-ccursor="lift"
          class="inline-flex items-center justify-center size-10 rounded-full bg-skin-button-muted/60 ring-1 ring-white/20 dark:ring-white/10 hover:ring-2 hover:ring-skin-hue/60 transition"
          aria-label="View next project"
        >
          <Icon name="mdi:arrow-right" class="size-5" />
        </button>
      </div>
    </div>

      <div class="projects-track relative flex flex-col gap-3 overflow-hidden md:min-h-[430px] md:items-center md:justify-center" role="region" aria-roledescription="carousel" aria-label="Projects" style={`--stack-count: ${projects?.length ?? 0};`}>
      {
        projects && projects.map(
          ({ url, description, highlights, name, isActive, github, stack, caseStudy }, index) => {
            const dxNotes = caseStudy?.DX ?? [];
            const uxNotes = caseStudy?.UX ?? [];
            const { stackEntries, mobileOverflowCount, desktopOverflowCount } = getStackSegments(stack);
            const shortDescription = shortDescriptionFrom(description);
            const caseStudySections = caseStudy
              ? {
                  overview: caseStudy.overview ?? (caseStudy.usage ? [caseStudy.usage] : []),
                  UX: uxNotes,
                  DX: dxNotes,
                  technicalNeeds: caseStudy.technicalNeeds ?? [],
                  tradeoffs: caseStudy.tradeoffs ?? [],
                  highlights: highlights ?? [],
                }
              : null;
            return (
              <div
                role="contentinfo"
                class="project-card group relative flex flex-col overflow-hidden rounded-xl border border-white/10 bg-skin-fill/95 shadow-[0_20px_50px_-30px_rgba(0,0,0,0.6)] transition-all duration-300 ease-in-out sm:hover:-translate-y-1 sm:hover:shadow-[0_30px_70px_-40px_rgba(0,0,0,0.7)]"
                style={`--stack-index: ${index};`}
              >
                <div class="project-card-glow" aria-hidden="true"></div>
                <div class="project-card-shell">
                  <div class="project-card-face project-card-front">
                    <div class="project-card-header">
                      <div class="project-card-title">
                        <span class="project-icon">
                          <Icon data-ccursor="lift" name="mdi:folder-outline" class="size-4" />
                        </span>
                        {isActive ? (
                          <a
                            data-ccursor="lift"
                            class="group flex items-center gap-[6px] text-lg font-semibold tracking-tight decoration-dotted underline-offset-[5px] hover:text-skin-hue hover:underline transition-all sm:hover:cursor-default"
                            href={url}
                            title={`${name}`}
                            target="_blank"
                          >
                            {name}
                            <span class="text-skin-hue transition ease-linear group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                              <Icon name="ri:arrow-up-line" class="rotate-45" />
                            </span>
                          </a>
                        ) : (
                          <span class="text-lg">{name}</span>
                        )}
                      </div>

                      <div class="project-card-actions">
                        {github && (
                          <a
                            data-ccursor="lift"
                            href={github}
                            title={`View ${name} in GitHub`}
                            aria-label={`View ${name} in GitHub`}
                            target="_blank"
                            rel="noopener"
                            class="project-github"
                          >
                            <Icon name="mdi:github" width={24} height={24} />
                          </a>
                        )}
                        {caseStudy && (
                          <button
                            type="button"
                            data-project-spin
                            aria-label={`Spin ${name} case study`}
                            class="project-case-button inline-flex"
                            data-ccursor="lift"
                          >
                            <Icon name="mdi:book-open-variant" width={18} height={18} />
                          </button>
                        )}
                      </div>
                    </div>

                    <p data-ccursor="noPadding" class='relative z-10 py-3 text-sm leading-relaxed text-skin-base sm:hidden'>
                      {description}
                    </p>
                    <p data-ccursor="noPadding" class='relative z-10 py-3 text-sm leading-relaxed text-skin-base hidden sm:block'>
                      {shortDescription}
                    </p>
                    <ul class='z-10 mt-1 text-sm'>
                      {highlights.map((highlight) => {
                        return <li data-ccursor class="w-full sm:w-max">{highlight}</li>;
                      })}
                    </ul>

                    <ul
                      class="flex print:hidden flex-wrap gap-2 mt-4"
                      aria-label="Technologies used"
                      data-stack-list
                      data-expanded="false"
                      data-mobile-overflow={String(mobileOverflowCount)}
                      data-desktop-overflow={String(desktopOverflowCount)}
                    >
                      {stackEntries.map(([label, icon], stackIndex) => (
                        <li data-stack-item data-stack-index={String(stackIndex)} class="project-chip flex gap-1.5 items-center border-skin-hue/30 text-skin-base print:p-0 print:bg-transparent print:text-zinc-800 border-solid print:border-none border rounded-full px-2.5 py-1 text-xs bg-skin-button-muted/70 hover:bg-skin-button-muted/90 hover:border-skin-hue/60 transition-all duration-200 ring-1 ring-inset ring-white/10 dark:ring-white/5 group/stack">
                          {icon &&
                            <span class="flex gap-1">
                            <Icon name={icon} width={16} height={16} class="text-skin-hue" /> <span class="project-chip-label transition-all duration-200">{label}</span>
                            </span>
                          }
                        </li>
                      ))}
                      <li data-stack-toggle class="project-chip items-center border-skin-hue/30 text-skin-base border-solid border rounded-full px-2.5 py-1 text-xs bg-skin-button-muted/70 hover:bg-skin-button-muted/90 hover:border-skin-hue/60 transition-all duration-200 ring-1 ring-inset ring-white/10 dark:ring-white/5">
                        <button
                          type="button"
                          data-stack-toggle-button
                          class="inline-flex items-center"
                          aria-expanded="false"
                        >
                          <span data-stack-toggle-label>Show less</span>
                        </button>
                      </li>
                    </ul>
                  </div>

                  {caseStudy && (
                    <div class="project-card-face project-card-back">
                      <div class="project-card-header">
                        <div class="project-card-title">
                          <span class="project-icon">
                            <Icon data-ccursor="lift" name="mdi:folder-outline" class="size-4" />
                          </span>
                          <span class="text-lg font-semibold">{name} Case Study</span>
                        </div>
                        <div class="project-case-tab-controls">

  <button
    type="button"
    class="project-case-tab-arrow"
    data-case-tab-prev
    data-ccursor="lift"
    aria-label={`View previous ${name} case study tab`}
  >
    <Icon name="mdi:chevron-left" class="size-3.5" />
  </button>

  <!-- DESKTOP TABS -->
  <div
    class="project-case-dots-header project-case-dots-header-desktop hidden lg:flex"
    role="tablist"
    aria-label="Desktop case study tabs"
  >
    {DESKTOP_CASE_TABS.map((sections, tabIndex) => (
      <button
        type="button"
        class:list={["project-case-dot-header", { "is-active": tabIndex === 0 }]}
        data-ccursor="lift"
        data-tab-index={tabIndex}
        data-tab-breakpoint="desktop"
        role="tab"
        aria-selected={tabIndex === 0}
        aria-label={sections.map((section) => CASE_STUDY_SECTION_TITLES[section]).join(" and ")}
      />
    ))}
  </div>

  <!-- MOBILE TABS -->
  <div
    class="project-case-dots-header project-case-dots-header-mobile flex lg:hidden"
    role="tablist"
    aria-label="Mobile case study tabs"
  >
    {MOBILE_CASE_TABS.map((sections, tabIndex) => (
      <button
        type="button"
        class:list={["project-case-dot-header", { "is-active": tabIndex === 0 }]}
        data-ccursor="lift"
        data-tab-index={tabIndex}
        data-tab-breakpoint="mobile"
        role="tab"
        aria-selected={tabIndex === 0}
        aria-label={sections.map((section) => CASE_STUDY_SECTION_TITLES[section]).join(" and ")}
      />
    ))}
  </div>

  <button
    type="button"
    class="project-case-tab-arrow"
    data-case-tab-next
    data-ccursor="lift"
    aria-label={`View next ${name} case study tab`}
  >
    <Icon name="mdi:chevron-right" class="size-3.5" />
  </button>

</div>
                        <div class="project-card-actions">
                          {github && (
                            <a
                              data-ccursor="lift"
                              href={github}
                              title={`View ${name} in GitHub`}
                              aria-label={`View ${name} in GitHub`}
                              target="_blank"
                              rel="noopener"
                              class="project-github"
                            >
                              <Icon name="mdi:github" width={24} height={24} />
                            </a>
                          )}
                          <button
                            type="button"
                            data-project-spin
                            aria-label={`Return from ${name} case study`}
                            class="project-case-button inline-flex"
                            data-ccursor="lift"
                          >
                            <Icon name="mdi:book-open-variant" width={18} height={18} />
                          </button>
                        </div>
                      </div>
                      <div
                        class="project-case-container"
                        data-active-tab="0"
                        data-case-tabs-desktop={JSON.stringify(DESKTOP_CASE_TABS)}
                        data-case-tabs-mobile={JSON.stringify(MOBILE_CASE_TABS)}
                      >
                        <div class="project-case-grid" data-case-grid>
                          {CASE_STUDY_SECTION_KEYS.map((sectionKey) => (
                            <div class="project-case-item" data-case-section={sectionKey}>
                              <h4>{CASE_STUDY_SECTION_TITLES[sectionKey]}</h4>
                              <ul>
                                {caseStudySections && caseStudySections[sectionKey].length > 0 ? (
                                  caseStudySections[sectionKey].map((item) => (
                                    <li>{item}</li>
                                  ))
                                ) : (
                                  <li>No {CASE_STUDY_SECTION_TITLES[sectionKey]} notes provided.</li>
                                )}
                              </ul>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            );
          },
        )
      }
    </div>
  </div>
</Section>
<script>
  import { Fancybox } from "@fancyapps/ui";
  Fancybox.bind('[data-fancybox="projects"]', { hideScrollbar: false });

  const projectsRoot = document.querySelector<HTMLElement>(".projects-coverflow");
  if (projectsRoot) {
    const maxMobileStack = 3;
    const maxDesktopStack = 4;

    const updateStackVisibility = (card: HTMLElement) => {
      const stackList = card.querySelector<HTMLElement>("[data-stack-list]");
      if (!stackList) return;

      const stackItems = Array.from(stackList.querySelectorAll<HTMLElement>("[data-stack-item]"));
      const toggleChip = stackList.querySelector<HTMLElement>("[data-stack-toggle]");
      const toggleButton = stackList.querySelector<HTMLButtonElement>("[data-stack-toggle-button]");
      const toggleLabel = stackList.querySelector<HTMLElement>("[data-stack-toggle-label]");
      const isDesktop = window.matchMedia("(min-width: 640px)").matches;
      const limit = isDesktop ? maxDesktopStack : maxMobileStack;
      const overflowCount = Math.max(0, stackItems.length - limit);
      const isExpanded = stackList.dataset.expanded === "true";

      stackItems.forEach((item, index) => {
        item.style.display = !isExpanded && index >= limit ? "none" : "flex";
      });

      if (!toggleChip || !toggleButton || !toggleLabel) return;
      if (overflowCount <= 0) {
        toggleChip.style.display = "none";
        return;
      }

      toggleChip.style.display = "flex";
      toggleLabel.textContent = isExpanded ? "Show less" : `+ ${overflowCount} more`;
      toggleButton.setAttribute("aria-expanded", String(isExpanded));
    };

    // make the region focusable for keyboard users and assist hover-based activation
    projectsRoot.tabIndex = 0;

    // keyboard handler used while pointer is inside the projects region or it's focused
    const keyHandler = (event: KeyboardEvent) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setActiveIndex(activeIndex - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        setActiveIndex(activeIndex + 1);
      }
    };

    const enableKeyboard = () => document.addEventListener("keydown", keyHandler);
    const disableKeyboard = () => document.removeEventListener("keydown", keyHandler);

    // Attach pointer/focus listeners to enable keyboard navigation only while relevant
    projectsRoot.addEventListener("pointerenter", enableKeyboard);
    projectsRoot.addEventListener("pointerleave", disableKeyboard);
    projectsRoot.addEventListener("focus", enableKeyboard);
    projectsRoot.addEventListener("blur", disableKeyboard);

    const cards = Array.from(
      projectsRoot.querySelectorAll<HTMLElement>(".project-card")
    );
    const prevButton = projectsRoot.querySelector("[data-projects-prev]");
    const nextButton = projectsRoot.querySelector("[data-projects-next]");
    const track = projectsRoot.querySelector<HTMLElement>(".projects-track");
    let activeIndex = Math.floor(cards.length / 2);

    const applyCoverflow = () => {
      const isDesktop = window.matchMedia("(min-width: 768px)").matches;
      const total = cards.length;
      const half = Math.floor(total / 2);
      cards.forEach((card, index) => {
        let offset = index - activeIndex;
        if (total > 0) {
          offset = ((offset + total + half) % total) - half;
        }
        const absOffset = Math.abs(offset);
        const translateX = offset * (isDesktop ? 220 : Math.min(250, (track?.clientWidth ?? window.innerWidth) * 0.67));
        const scale = 1 - Math.min(absOffset * (isDesktop ? 0.12 : 0.08), isDesktop ? 0.36 : 0.24);
        const rotateY = offset * (isDesktop ? -12 : -8);
        const maxVisible = isDesktop ? Math.max(2, Math.min(3, half)) : 1;
        const opacity = absOffset > maxVisible ? 0 : 1 - absOffset * 0.15;

        card.style.transform = `translate(-50%, -50%) translateX(${translateX}px) scale(${scale}) rotateY(${rotateY}deg)`;
        card.style.zIndex = String(10 - absOffset);
        card.style.opacity = String(opacity);
        card.style.filter = absOffset === 0 ? "none" : "saturate(0.85)";
        card.style.pointerEvents = absOffset === 0 ? "auto" : "none";
        card.classList.toggle("is-active", absOffset === 0);
      });

      if (track) {
        if (isDesktop) {
          const tallestCard = cards.reduce((height, card) => Math.max(height, card.offsetHeight), 0);
          track.style.height = `${Math.max(430, tallestCard + 32)}px`;
        } else {
          const activeCard = cards[activeIndex];
          track.style.height = activeCard ? `${Math.max(280, activeCard.offsetHeight + 32)}px` : "";
        }
      }
    };

    let swipeStart: { x: number; y: number; pointerId: number } | null = null;
    track?.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse") return;
      swipeStart = { x: event.clientX, y: event.clientY, pointerId: event.pointerId };
      if (event.isTrusted) track.setPointerCapture(event.pointerId);
    });
    track?.addEventListener("pointerup", (event) => {
      if (!swipeStart || swipeStart.pointerId !== event.pointerId) return;
      const deltaX = event.clientX - swipeStart.x;
      const deltaY = event.clientY - swipeStart.y;
      swipeStart = null;
      if (Math.abs(deltaX) < 45 || Math.abs(deltaX) < Math.abs(deltaY) * 1.2) return;
      setActiveIndex(activeIndex + (deltaX < 0 ? 1 : -1));
    });
    track?.addEventListener("pointercancel", () => { swipeStart = null; });

    const clampIndex = (index: number) => {
      if (cards.length === 0) return 0;
      if (index < 0) return cards.length - 1;
      if (index >= cards.length) return 0;
      return index;
    };

    const setActiveIndex = (index: number) => {
      activeIndex = clampIndex(index);
      applyCoverflow();
    };

    prevButton?.addEventListener("click", () => setActiveIndex(activeIndex - 1));
    nextButton?.addEventListener("click", () => setActiveIndex(activeIndex + 1));

    cards.forEach((card, index) => {
      card.addEventListener("click", () => {
        const isDesktop = window.matchMedia("(min-width: 768px)").matches;
        if (isDesktop) {
          setActiveIndex(index);
        }
      });
    });

    const getActiveTabConfig = (container: HTMLElement) => {
      const isDesktop = window.matchMedia("(min-width: 1024px)").matches;
      const datasetValue = isDesktop ? container.dataset.caseTabsDesktop : container.dataset.caseTabsMobile;
      if (!datasetValue) return [] as string[][];
      try {
        const parsed = JSON.parse(datasetValue) as string[][];
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };

    const updateCaseStudyView = (card: HTMLElement, requestedTab?: number) => {
      const container = card.querySelector<HTMLElement>(".project-case-container");
      if (!container) return;
      const sections = Array.from(card.querySelectorAll<HTMLElement>("[data-case-section]"));
      const tabConfig = getActiveTabConfig(container);
      if (tabConfig.length === 0 || sections.length === 0) return;

      const currentActiveTab = Number(container.dataset.activeTab ?? "0");
      const normalizedTab = Number.isNaN(requestedTab ?? Number.NaN)
        ? currentActiveTab
        : Math.min(Math.max(requestedTab ?? 0, 0), tabConfig.length - 1);
      container.dataset.activeTab = String(normalizedTab);

      const activeSections = new Set(tabConfig[normalizedTab] ?? []);
      sections.forEach((section) => {
        const sectionKey = section.dataset.caseSection;
        const isVisible = sectionKey ? activeSections.has(sectionKey) : false;
        section.classList.toggle("is-active", isVisible);
      });

      const activeBreakpoint = window.matchMedia("(min-width: 1024px)").matches ? "desktop" : "mobile";
      const dots = card.querySelectorAll<HTMLButtonElement>(".project-case-dot-header");
      dots.forEach((dot) => {
        const dotBreakpoint = dot.dataset.tabBreakpoint;
        const dotIndex = Number(dot.dataset.tabIndex ?? "0");
        const isCurrentBreakpoint = dotBreakpoint === activeBreakpoint;
        const isActiveDot = isCurrentBreakpoint && dotIndex === normalizedTab;
        dot.classList.toggle("is-active", isActiveDot);
        dot.setAttribute("aria-selected", String(isActiveDot));
      });
    };

    const syncCardHeights = () => {
      cards.forEach((card) => card.style.removeProperty("--project-card-height"));

      let sharedHeight = 0;
      cards.forEach((card) => {
        const container = card.querySelector<HTMLElement>(".project-case-container");
        if (!container) {
          sharedHeight = Math.max(sharedHeight, card.offsetHeight);
          return;
        }

        const wasFlipped = card.classList.contains("is-flipped");
        const selectedTab = Number(container.dataset.activeTab ?? "0");
        const tabCount = getActiveTabConfig(container).length;

        card.classList.remove("is-flipped");
        sharedHeight = Math.max(sharedHeight, card.offsetHeight);
        card.classList.add("is-flipped");

        for (let tabIndex = 0; tabIndex < tabCount; tabIndex += 1) {
          updateCaseStudyView(card, tabIndex);
          sharedHeight = Math.max(sharedHeight, card.offsetHeight);
        }

        if (!wasFlipped) card.classList.remove("is-flipped");
        updateCaseStudyView(card, selectedTab);
      });

      cards.forEach((card) => {
        card.style.setProperty("--project-card-height", `${sharedHeight}px`);
      });
    };

    projectsRoot.querySelectorAll<HTMLButtonElement>("[data-project-spin]").forEach((button) => {
      button.addEventListener("click", (event) => {
        event.stopPropagation();
        const card = (button as HTMLElement).closest<HTMLElement>(".project-card");
        if (!card) return;
        card.classList.toggle("is-flipped");

        if (!card.classList.contains("is-flipped")) {
          updateCaseStudyView(card, 0);
        }
        requestAnimationFrame(applyCoverflow);
      });
    });

    projectsRoot.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
      updateCaseStudyView(card, 0);
      updateStackVisibility(card);

      const caseStudyContainer = card.querySelector<HTMLElement>(".project-case-container");
      const previousTabButton = card.querySelector<HTMLButtonElement>("[data-case-tab-prev]");
      const nextTabButton = card.querySelector<HTMLButtonElement>("[data-case-tab-next]");
      const moveCaseStudyTab = (direction: number) => {
        if (!caseStudyContainer) return;
        const tabCount = getActiveTabConfig(caseStudyContainer).length;
        if (tabCount === 0) return;
        const currentTab = Number(caseStudyContainer.dataset.activeTab ?? "0");
        const nextTab = (currentTab + direction + tabCount) % tabCount;
        updateCaseStudyView(card, nextTab);
        requestAnimationFrame(applyCoverflow);
      };

      previousTabButton?.addEventListener("click", (event) => {
        event.stopPropagation();
        moveCaseStudyTab(-1);
      });
      nextTabButton?.addEventListener("click", (event) => {
        event.stopPropagation();
        moveCaseStudyTab(1);
      });

      const toggleButton = card.querySelector<HTMLButtonElement>("[data-stack-toggle-button]");
      const stackList = card.querySelector<HTMLElement>("[data-stack-list]");
      toggleButton?.addEventListener("click", (event) => {
        event.stopPropagation();
        if (!stackList) return;
        stackList.dataset.expanded = stackList.dataset.expanded === "true" ? "false" : "true";
        updateStackVisibility(card);
        syncCardHeights();
        requestAnimationFrame(applyCoverflow);
      });
    });

    projectsRoot.querySelectorAll<HTMLButtonElement>(".project-case-dot-header").forEach((dot) => {
      dot.addEventListener("click", (event) => {
        event.stopPropagation();
        const card = (event.target as HTMLElement).closest<HTMLElement>(".project-card");
        if (!card) return;
        updateCaseStudyView(card, Number(dot.dataset.tabIndex ?? "0"));
        requestAnimationFrame(applyCoverflow);
      });
    });

    window.addEventListener("resize", () => {
      projectsRoot.querySelectorAll<HTMLElement>(".project-card").forEach((card) => {
        updateCaseStudyView(card);
        updateStackVisibility(card);
      });
      syncCardHeights();
      applyCoverflow();
    });
    syncCardHeights();
    applyCoverflow();
    document.fonts?.ready.then(() => {
      syncCardHeights();
      applyCoverflow();
    });
    // ensure keyboard is disabled initially
    disableKeyboard();
  }
</script>

<style>
  ul {
    @apply ml-4 list-disc space-y-1;
    li {
      @apply text-skin-muted marker:text-skin-hue;
    }
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-size: 0.6rem;
  }

  footer span {
    border-radius: 6px;
    background: #eee;
    color: #444;
    font-size: 0.6rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

  .projects-track {
